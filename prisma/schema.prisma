generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  price       Float
  oldPrice    Float?
  stock       Int      @default(0)
  category    String
  images      String[] // Prisma supports scalar lists in Postgres
  badge       String?  // e.g. "full2h", "-10%"
  
  orderItems  OrderItem[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Order {
  id            String   @id @default(uuid())
  customerName  String
  customerEmail String
  customerPhone String?
  
  total         Float
  status        String   @default("PENDENTE") // PENDENTE, PAGO, ENVIADO, ENTREGUE, CANCELADO
  
  items         OrderItem[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model OrderItem {
  id        String  @id @default(uuid())
  quantity  Int
  price     Float   // Price at the time of purchase
  
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
}
